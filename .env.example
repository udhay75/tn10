# ==============================================================================
# Tamil Nadu Class 10 PWA Study Checklist & Notes Environment Configuration
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (defaults to true if Supabase URL is not set)
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 1. Coolify MongoDB Configuration (Recommended for Coolify deployment)
# ------------------------------------------------------------------------------
# Set this to your Coolify MongoDB connection string:
# e.g., mongodb://coolify_user:coolify_pass@mongodb:27017/tn10_study
MONGODB_URI=mongodb://localhost:27017/tn10_study
MONGODB_DB=tn10_study

# ------------------------------------------------------------------------------
# 2. PostgreSQL Configuration (For Local Docker development: tn10_postgres)
# ------------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tn10_study

# ------------------------------------------------------------------------------
# 3. Optional Supabase Configuration (Optional cloud sync)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
