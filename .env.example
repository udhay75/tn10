# ==============================================================================
# Tamil Nadu Class 10 PWA Study Checklist & Notes Environment Configuration
# ==============================================================================

# Application Base URL (used in email links and PWA metadata)
NEXT_PUBLIC_APP_URL=https://tn10.udhees.com

# ------------------------------------------------------------------------------
# 1. Coolify MongoDB Configuration (Recommended for Coolify deployment)
# ------------------------------------------------------------------------------
# Set this to your Coolify MongoDB connection string:
# e.g., mongodb://coolify_user:coolify_pass@mongodb:27017/tn10_study
MONGODB_URI=mongodb://localhost:27017/tn10_study
MONGODB_DB=tn10_study

# ------------------------------------------------------------------------------
# 2. SMTP Email Configuration (Required for "Forgot Password" Email Delivery)
# Supports Gmail, SendGrid, Amazon SES, Mailgun, Brevo, Postmark, or Coolify Mail
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-or-smtp-key
SMTP_FROM="TN Class 10 Study PWA" <noreply@tn10.udhees.com>

# ------------------------------------------------------------------------------
# 3. PostgreSQL Configuration (For Local Docker development: tn10_postgres)
# ------------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tn10_study

# ------------------------------------------------------------------------------
# 4. Optional Supabase Configuration (Optional cloud sync)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
